 <class>qtractorAudioEditorForm</class>
 <widget class="QMainWindow" name="qtractorAudioEditorForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Audio Editor</string>
  </property>
  <property name="windowIcon">
   <iconset theme="qtractorAudioEditor" />
  </property>
  <widget class="QMenuBar" name="menuBar">
   <property name="geometry">
    <rect>
