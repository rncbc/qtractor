          <string>Panning balance (-100=L, 0=C, +100=R)</string>
         </property>
         <property name="suffix">
          <string> %</string>
         </property>
         <property name="accelerated">
          <bool>true</bool>
         </property>
         <property name="decimals">
          <number>1</number>
         </property>
         <property name="minimum">
          <double>-100.0</double>
         </property>
         <property name="maximum">
          <double>100.0</double>
         </property>
         <property name="singleStep">
          <double>1.0</double>
         </property>
         <property name="value">
          <double>0.0</double>
         </property>
        </widget>
       </item>
       <item row="1" column="3">
        <spacer>
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="2" column="0" colspan="4">
        <spacer>
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <!-- ══════════════════════════════════════════════════════════ -->
     <!-- Tab 2: Normalize                                           -->
     <!-- ══════════════════════════════════════════════════════════ -->
     <widget class="QWidget" name="NormalizeTab">
