 <class>qtractorAudioToolsForm</class>
 <widget class="QDialog" name="qtractorAudioToolsForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>480</width>
    <height>240</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Audio Tools</string>
  </property>
  <property name="windowIcon">
   <iconset theme="qtractorAudioEditor" />
  </property>
  <layout class="QVBoxLayout">
   <property name="spacing">
    <number>4</number>
   </property>
   <property name="margin">
    <number>4</number>
   </property>
   <item>
    <layout class="QHBoxLayout">
     <property name="spacing">
      <number>2</number>
     </property>
     <property name="margin">
      <number>2</number>
     </property>
     <item>
      <widget class="QComboBox" name="PresetNameComboBox">
       <property name="minimumSize">
        <size>
         <width>160</width>
         <height>0</height>
        </size>
       </property>
       <property name="toolTip">
        <string>Preset name</string>
       </property>
       <property name="editable">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="PresetSaveToolButton">
       <property name="focusPolicy">
        <enum>Qt::TabFocus</enum>
       </property>
       <property name="toolTip">
        <string>Save preset</string>
       </property>
       <property name="text">
        <string/>
       </property>
       <property name="icon">
        <iconset theme="formSave" />
       </property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="PresetDeleteToolButton">
       <property name="focusPolicy">
        <enum>Qt::TabFocus</enum>
       </property>
       <property name="toolTip">
        <string>Delete preset</string>
       </property>
       <property name="text">
        <string/>
       </property>
       <property name="icon">
        <iconset theme="formRemove" />
       </property>
      </widget>
     </item>
     <item>
      <spacer>
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>180</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="ToolTabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <!-- ══════════════════════════════════════════════════════════ -->
     <!-- Tab 0: Gain                                                -->
     <!-- ══════════════════════════════════════════════════════════ -->
     <widget class="QWidget" name="GainTab">
      <attribute name="title">
       <string>&amp;Gain</string>
      </attribute>
      <layout class="QGridLayout">
       <property name="spacing">
        <number>4</number>
       </property>
       <item row="0" column="0" colspan="4">
        <widget class="QCheckBox" name="GainCheckBox">
         <property name="font">
          <font>
           <weight>75</weight>
           <bold>true</bold>
          </font>
         </property>
         <property name="toolTip">
          <string>Apply gain to selected audio</string>
         </property>
         <property name="text">
          <string>&amp;Gain</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <spacer>
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeType">
          <enum>QSizePolicy::Fixed</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="1" column="1">
        <widget class="QLabel" name="GainLabel">
         <property name="text">
          <string>Value:</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignRight|Qt::AlignVCenter</set>
         </property>
        </widget>
       </item>
       <item row="1" column="2">
        <widget class="QDoubleSpinBox" name="GainSpinBox">
         <property name="minimumSize">
          <size>
           <width>60</width>
           <height>0</height>
          </size>
         </property>
         <property name="toolTip">
          <string>Gain value in dBfs</string>
         </property>
         <property name="suffix">
          <string> dBfs</string>
         </property>
         <property name="accelerated">
          <bool>true</bool>
         </property>
         <property name="decimals">
          <number>1</number>
         </property>
         <property name="minimum">
          <double>-70.0</double>
         </property>
         <property name="maximum">
          <double>6.0</double>
         </property>
         <property name="singleStep">
          <double>0.1</double>
         </property>
         <property name="value">
          <double>0.0</double>
         </property>
        </widget>
       </item>
       <item row="1" column="3">
        <spacer>
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="2" column="0" colspan="4">
        <spacer>
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <!-- ══════════════════════════════════════════════════════════ -->
     <!-- Tab 1: Panning                                             -->
     <!-- ══════════════════════════════════════════════════════════ -->
     <widget class="QWidget" name="PanningTab">
      <attribute name="title">
       <string>P&amp;anning</string>
      </attribute>
      <layout class="QGridLayout">
       <property name="spacing">
        <number>4</number>
       </property>
       <item row="0" column="0" colspan="4">
        <widget class="QCheckBox" name="PanningCheckBox">
         <property name="font">
